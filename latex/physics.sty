% ===== Easy Vectors =====

% Geometry
\newcommand{\x}{\vec{x}}
\newcommand{\y}{\vec{y}}
\newcommand{\z}{\vec{z}}
\newcommand{\n}{\vec{n}}

% Fields
\newcommand{\B}{\vec{B}}
\newcommand{\E}{\vec{E}}
\newcommand{\F}{\vec{F}}

% Current
\newcommand{\jvec}{\vec{\jmath}}

% Securely define \vnabla
\providecommand{\vnabla}{}
\renewcommand{\vnabla}{\vec{\nabla}}

% Motion
\newcommand{\vel}{\vec{v}}
\newcommand{\acc}{\vec{a}}

% Energy
\newcommand{\en}{\mathcal{E}}

